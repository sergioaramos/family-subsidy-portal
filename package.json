{
  "name": "family-subsidy-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --project unit --project contract",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "typecheck:backend": "tsc --noEmit -p amplify/tsconfig.json"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "aws-amplify": "^6.22.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1143.0",
    "@aws-sdk/client-dynamodb": "^3.1143.0",
    "@aws-sdk/lib-dynamodb": "^3.1143.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
